# GitHub OAuth Credentials
# Create OAuth App at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# OpenAI API Key
# Get API Key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# MongoDB Atlas Connection String
# Default set to your provided cluster
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/gittenz

# Redis Cloud Configuration
# Get details from Redis Cloud console
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_USERNAME=default
SPRING_DATA_REDIS_PASSWORD=

# Frontend URL (Update this if your frontend port changes)
FRONTEND_URL=http://localhost:5180

# Initial Admin Email Setup
ADMIN_INITIAL_EMAIL=admin_email@example.com

# JWT Authentication
# Must be a 64-character hex string (at least 256-bit)
JWT_SECRET_KEY=your_64_character_secure_jwt_secret_key_here

# Developer Information (Used for internal links and support)
DEVELOPER_LINKEDIN_URL=https://www.linkedin.com/in/yourprofile/
DEVELOPER_GITHUB_URL=https://github.com/yourusername
DEVELOPER_EMAIL=developer@example.com

# Resend API Configuration
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
